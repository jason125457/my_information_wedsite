{
  "name": "personal-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "job:ingest": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "job:digest": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/digest.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:build": "opennextjs-cloudflare build",
    "job:backfill-images": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/backfill-images.ts",
    "job:weekly": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/weekly.ts"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "1.44.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.0",
    "wrangler": "4.146.0"
  }
}
