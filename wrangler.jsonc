{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-feed",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "personal-feed"
    }
  ],
  "routes": [
    { "pattern": "www.shuns.site", "custom_domain": true }
  ],
  // Non-secret runtime values. Secrets (SUPABASE_SERVICE_ROLE_KEY,
  // ALLOWED_EMAIL) are set with `wrangler secret put` and never committed.
  // NEXT_PUBLIC_* values are inlined at build time from the build environment.
  "vars": {
    "APP_URL": "https://www.shuns.site"
  },
  "observability": {
    "enabled": true
  }
}
