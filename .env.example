# Application
APP_URL=http://localhost:3000
ALLOWED_EMAIL=you@example.com

# Supabase (safe browser configuration)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# AI processing (server-only). Free Google AI Studio key; never enable billing on its project.
GEMINI_API_KEY=
# Model IDs. The "-latest" aliases follow Google's current free-tier models.
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_QUALITY=gemini-flash-lite-latest
# Minimum milliseconds between Gemini requests (free tier has a low per-minute limit).
GEMINI_MIN_INTERVAL_MS=6000

# Daily Digest notification (optional, server-only)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_USER_ID=
