# Application
APP_URL=http://localhost:3000
ALLOWED_EMAIL=you@example.com

# Supabase (safe browser configuration)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only)
SUPABASE_SERVICE_ROLE_KEY=

# AI processing (server-only). Free Google AI Studio key; never enable billing on its project.
GEMINI_API_KEY=
# Model IDs (not display names). Free-tier quotas are per model, so two different
# Flash Lite models give classification and summaries separate 500/day budgets.
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_QUALITY=gemini-3.5-flash-lite
# Minimum milliseconds between Gemini requests (Flash Lite free tier: 15/minute).
GEMINI_MIN_INTERVAL_MS=5000

# Daily Digest notification (optional, server-only)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_TARGET_USER_ID=
